EDGE_CONTROLLER_URL=http://spoo-lin.spoocannon.com:8080
EDGE_CONTROLLER_TIMEOUT=5
EDGE_NODE_ID=
EDGE_SERVICE_ID=edge-video
EDGE_SERVICE_NAME=edge-video
EDGE_SERVICE_VERSION=${SER_VER}

# Node-local edge-time service. Use the hosting node address/port, not a Docker name.
EDGE_TIME_URL=http://127.0.0.1:8095
EDGE_TIME_TIMEOUT_SECONDS=2

EDGE_VIDEO_CAMERA_INDEX=0
EDGE_VIDEO_WIDTH=1920
EDGE_VIDEO_HEIGHT=1080
EDGE_VIDEO_FRAMERATE=30
EDGE_VIDEO_BITRATE=12000000
EDGE_VIDEO_SEGMENT_SECONDS=60
EDGE_VIDEO_INLINE_HEADERS=true
EDGE_VIDEO_EVIDENCE_ROOT=/recordings
EDGE_CONTROLLER_REGISTER_INTERVAL_SECONDS=30
EDGE_VIDEO_HEALTH_PORT=8090

# Enable the node-local live stream.
EDGE_VIDEO_ENABLE_STREAM=false
EDGE_VIDEO_LIVE_ROOT=/tmp/edge-video-live
EDGE_VIDEO_HLS_SEGMENT_SECONDS=2
EDGE_VIDEO_HLS_SEGMENT_COUNT=4